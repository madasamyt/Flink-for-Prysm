{
  "namespace": "com.nuskin.prysm.avro.device",
  "type": "record",
  "name": "DeviceTelemetry",
  "doc": "Health and operational telemetry from Prysm scanning devices.",
  "fields": [
    {"name": "deviceId",          "type": "string", "doc": "Prysm device serial number"},
    {"name": "schemaVersion",     "type": "int", "default": 1},
    {"name": "eventTime",         "type": "long", "logicalType": "timestamp-millis"},
    {"name": "eventType",         "type": {"type": "enum", "name": "TelemetryEventType",
                                            "symbols": ["HEARTBEAT","SCAN_STARTED","SCAN_COMPLETED",
                                                        "SCAN_FAILED","FIRMWARE_UPDATE","CALIBRATION",
                                                        "ERROR","SHUTDOWN"]},
                                  "default": "HEARTBEAT"},
    {"name": "firmwareVersion",   "type": ["null","string"], "default": null},
    {"name": "batteryLevel",      "type": ["null","int"],    "default": null, "doc": "Percentage 0-100"},
    {"name": "storageUsedMb",     "type": ["null","long"],   "default": null},
    {"name": "wifiSignalDbm",     "type": ["null","int"],    "default": null},
    {"name": "cpuTempCelsius",    "type": ["null","float"],  "default": null},
    {"name": "cameraStatus",      "type": {"type": "enum", "name": "CameraStatus",
                                            "symbols": ["OK","DIRTY","OBSTRUCTED","FAILED","UNKNOWN"]},
                                  "default": "UNKNOWN"},
    {"name": "lightStatus",       "type": {"type": "enum", "name": "LightStatus",
                                            "symbols": ["OK","DEGRADED","FAILED","UNKNOWN"]},
                                  "default": "UNKNOWN"},
    {"name": "locationId",        "type": ["null","string"], "default": null,
                                  "doc": "Store/kiosk location identifier"},
    {"name": "associatedCustomerId","type": ["null","string"], "default": null,
                                  "doc": "Customer currently using the device (null for unattended events)"},
    {"name": "errorCode",         "type": ["null","string"], "default": null},
    {"name": "errorMessage",      "type": ["null","string"], "default": null},
    {"name": "metadata",          "type": {"type": "map", "values": "string"}, "default": {}}
  ]
}
