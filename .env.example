# ============================================================
# Prysm Flink Pipeline — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ── Environment ──────────────────────────────────────────────
PRYSM_ENV=dev        # dev | staging | prod
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ── AWS Credentials ───────────────────────────────────────────
# Prefer IAM roles (ECS task role / EKS IRSA) in production.
# These are only needed for local development / CI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # required for STS temporary credentials

# ── Local development overrides ───────────────────────────────
# Set these when running against LocalStack
# AWS_ENDPOINT_URL=http://localhost:4566
# KINESIS_STARTING_POSITION=TRIM_HORIZON   # backfill from start in dev

# ── Flink ─────────────────────────────────────────────────────
# FLINK_PARALLELISM=4
# KINESIS_STARTING_POSITION=LATEST

# ── Glue Schema Registry ──────────────────────────────────────
# Auto-register schemas in dev only — keep false in prod
GLUE_AUTO_REGISTER=true   # set to false in prod
